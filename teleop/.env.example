# LiveKit Portal connection settings for xr_teleoperate (portal mode).
# Copy to .env and fill in your credentials. Real environment variables
# take precedence over this file.

LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=your-api-key
LIVEKIT_API_SECRET=your-api-secret

# Room used by robot gateway / mock robot + teleop operator + webviewer.
LIVEKIT_ROOM=g1-portal
